# ---------------------------------------------------------------------------
# Organic Orbit Digital — environment configuration
# Copy this file to `.env.local` (development) or `.env.production` (build)
# and fill in the values. NEVER commit real values.
#
# IMPORTANT: Because the site is a static export, every variable used by the
# browser must start with NEXT_PUBLIC_ and is embedded into the built files at
# BUILD TIME. Only put values here that are designed to be public (form
# endpoint IDs / public access keys). Never put SMTP passwords or private API
# keys in NEXT_PUBLIC_ variables. Rebuild after changing any value.
# ---------------------------------------------------------------------------

# Which form delivery provider to use for the contact form.
# Allowed values: formspree | web3forms | custom
# Leave empty to disable online submission (the form will then offer a
# pre-filled email to info@organicorbitdigital.com instead — nothing is faked).
NEXT_PUBLIC_FORM_PROVIDER=

# formspree: your form endpoint, e.g. https://formspree.io/f/abcdwxyz
# custom:    any HTTPS endpoint that accepts a JSON POST and responds with
#            HTTP 2xx and JSON { "success": true } or { "ok": true }
NEXT_PUBLIC_FORM_ENDPOINT=

# web3forms: the public Access Key from https://web3forms.com
# (Web3Forms access keys are designed to be used in client-side code.)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
