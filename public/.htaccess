# ---------------------------------------------------------------------------
# Organic Orbit Digital — Apache / cPanel static hosting configuration
# Copied automatically into `out/.htaccess` during `npm run build`.
# ---------------------------------------------------------------------------

Options -Indexes

# Serve custom 404 page generated by Next.js static export
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Permanently strip ?service=... query strings on /contact/ to clean /contact/ URL
  RewriteCond %{REQUEST_URI} ^/(?:(de|es|fr|ar|ur)/)?contact/?$ [NC]
  RewriteCond %{QUERY_STRING} (^|&)service= [NC]
  RewriteRule ^ https://organicorbitdigital.com%{REQUEST_URI}? [R=301,L,QSD]

  # Allow clean /de, /es, /fr, /ar, /ur URLs without forcing a trailing slash redirect
  RewriteRule ^(de|es|fr|ar|ur)$ /$1/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
